---
import "../styles/global.css";
import Cursor from "../components/Cursor.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Alexandra Lerner – Product Designer",
	description = "Portfolio de Alexandra Lerner, Product Designer.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- scroll reveal: hide [data-reveal] only when JS runs; if the reveal script has not
		     started by the load event (it failed), show everything instead of leaving it invisible -->
		<script is:inline>
			document.documentElement.classList.add("reveal-on");
			addEventListener("load", function () {
				var r = document.documentElement;
				if (!r.classList.contains("reveal-ready")) r.classList.remove("reveal-on");
			});
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Martian+Mono:wght@400;700&family=Space+Grotesk:wght@400;500;700&family=Hanken+Grotesk:wght@400&family=Instrument+Serif&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="page-shell">
			<div class="page-frame">
				<slot />
			</div>
		</div>

		<Cursor />

		<script>
			// Scroll reveal: each [data-reveal] element fades/rises in (global.css) once, when its top
			// enters the viewport. threshold 0 so tall elements trigger as soon as they show up, at any
			// viewport size; elements entering in the same frame get a short top-to-bottom stagger.
			const root = document.documentElement;
			const pending = new Set<HTMLElement>(document.querySelectorAll<HTMLElement>("[data-reveal]"));

			const show = (el: HTMLElement, delay = 0) => {
				if (!pending.delete(el)) return;
				io?.unobserve(el);
				if (delay) {
					el.style.transitionDelay = `${delay}ms`;
					el.addEventListener("transitionend", () => el.style.removeProperty("transition-delay"), { once: true });
				}
				el.classList.add("is-in");
			};

			// no animation: for elements already scrolled past (restored scroll, anchor jumps)
			const showNow = (el: HTMLElement) => {
				el.style.transition = "none";
				show(el);
				void el.offsetWidth;
				el.style.removeProperty("transition");
			};

			const io =
				"IntersectionObserver" in window
					? new IntersectionObserver(
							(entries) => {
								entries
									.filter((e) => e.isIntersecting)
									.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
									.forEach((e, i) => show(e.target as HTMLElement, Math.min(i, 4) * 70));
							},
							{ threshold: 0, rootMargin: "0px 0px -5% 0px" }
						)
					: null;

			// anything whose top is already above the viewport (jumped over or restored past) shows at once
			const revealPassed = () => {
				for (const el of pending) if (el.getBoundingClientRect().top < 0) showNow(el);
			};

			if (io) {
				pending.forEach((el) => io.observe(el));
				revealPassed();
				addEventListener("load", revealPassed);
				addEventListener("hashchange", revealPassed);
				addEventListener("pageshow", revealPassed);
			} else {
				pending.forEach(showNow);
			}
			root.classList.add("reveal-ready");
		</script>
	</body>
</html>

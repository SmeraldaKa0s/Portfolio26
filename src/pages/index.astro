---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Work from "../components/Work.astro";
import About from "../components/About.astro";
import TrustedBy from "../components/TrustedBy.astro";
import Experience from "../components/Experience.astro";
import Press from "../components/Press.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import HalftoneBackground from "../components/HalftoneBackground.astro";
---

<Layout>
	<div class="hero-screen">
		<Nav />
		<Hero />
	</div>
	<Work />
	<About />
	<TrustedBy />
	<div class="halftone-zone">
		<HalftoneBackground sticky />
		<Experience />
		<Press />
		<CTA />
		<Footer />
	</div>
</Layout>

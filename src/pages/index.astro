---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Work from "../components/Work.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Press from "../components/Press.astro";
import CTA from "../components/CTA.astro";
import HalftoneBackground from "../components/HalftoneBackground.astro";
import { homeMarkdownPath } from "../lib/markdown";
---

<Layout markdown={homeMarkdownPath}>
	<div class="hero-screen">
		<HalftoneBackground />
		<Nav />
		<Hero />
	</div>
	<Work />
	<About />
	<div class="halftone-zone">
		<HalftoneBackground mode="sticky" />
		<Experience />
		<Press />
		<CTA />
	</div>
</Layout>

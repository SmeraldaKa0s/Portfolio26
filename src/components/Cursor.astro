---
// Cursor personalizado de ashcamp.co: un círculo blanco de 10px con mix-blend-mode: difference,
// por eso cambia de color según lo que tenga debajo (se invierte sobre superficies claras como la
// pastilla "Hablemos"). Crece a 14px sobre elementos interactivos, baja a 8px al hacer clic, con el
// mismo resorte de 0.4s (bounce 0.2). Solo en dispositivos con mouse.
---

<div class="cursor" aria-hidden="true"></div>

<style is:global>
	.cursor {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 2147483647;
		width: 10px;
		height: 10px;
		margin: -5px 0 0 -5px;
		border-radius: 50%;
		background: #fff;
		mix-blend-mode: difference;
		pointer-events: none;
		opacity: 0;
		will-change: transform;
		/* resorte aproximado: duración 0.4s, rebote 0.2 */
		transition:
			width 0.4s cubic-bezier(0.34, 1.4, 0.64, 1),
			height 0.4s cubic-bezier(0.34, 1.4, 0.64, 1),
			margin 0.4s cubic-bezier(0.34, 1.4, 0.64, 1),
			opacity 0.2s ease;
	}

	.cursor.is-visible {
		opacity: 1;
	}

	.cursor.is-hover {
		width: 14px;
		height: 14px;
		margin: -7px 0 0 -7px;
	}

	.cursor.is-pressed {
		width: 8px;
		height: 8px;
		margin: -4px 0 0 -4px;
	}

	/* el cursor del sistema se oculta solo cuando el nuestro está activo (mouse + JS) */
	html.has-cursor,
	html.has-cursor * {
		cursor: none !important;
	}

	@media (hover: none), (pointer: coarse) {
		.cursor {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			transition: opacity 0.2s ease;
		}
	}
</style>

<script>
	const cursor = document.querySelector<HTMLElement>(".cursor");
	const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;

	if (cursor && fine) {
		const INTERACTIVE = 'a, button, [role="button"], input, textarea, select, summary, label, [data-copy-email]';
		const root = document.documentElement;

		window.addEventListener(
			"pointermove",
			(e) => {
				if (e.pointerType !== "mouse") return;
				root.classList.add("has-cursor");
				cursor.classList.add("is-visible");
				cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
				const el = e.target as Element | null;
				cursor.classList.toggle("is-hover", !!el?.closest?.(INTERACTIVE));
			},
			{ passive: true },
		);

		window.addEventListener("pointerdown", () => cursor.classList.add("is-pressed"));
		window.addEventListener("pointerup", () => cursor.classList.remove("is-pressed"));
		document.addEventListener("mouseleave", () => cursor.classList.remove("is-visible"));
		document.addEventListener("mouseenter", () => cursor.classList.add("is-visible"));
	}
</script>

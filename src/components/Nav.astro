---
import ChatButton from "./ChatButton.astro";

const links = [
	{ href: "/#index", label: "Index" },
	{ href: "/#work", label: "Work" },
	{ href: "/#info", label: "Info" },
];
const email = "alek.xandra.lerner@gmail.com";
// TODO: replace with the real LinkedIn profile URL
const linkedin = "https://www.linkedin.com/";
---

<!-- in-flow slot: keeps the nav's height and draws the dashed frame lines; the nav itself is a fixed,
     transparent overlay so the content scrolls beneath it -->
<div class="nav-slot frame split" aria-hidden="true">
	<div class="col-narrow"></div>
	<div class="col-wide"></div>
</div>

<header class="nav" data-nav>
	<!-- desktop (≥ 768px) -->
	<div class="split nav__desktop">
		<div class="col-narrow nav__links-cell">
			<nav class="nav__links">
				{links.map((link) => (
					<a href={link.href}>
						<span class="swap">
							<span>{link.label}</span>
							<span aria-hidden="true">{link.label}</span>
						</span>
					</a>
				))}
			</nav>
		</div>

		<div class="col-wide nav__meta-cell">
			<span class="nav__clock" data-clock>
				<span class="nav__dot" data-clock-dot></span>
				<span class="nav__time" data-clock-time>--:--:-- --</span>
			</span>

			<ChatButton href="#contact" label="Hablemos" ariaLabel="Hablemos: ir a contacto" />
		</div>
	</div>

	<!-- mobile (< 768px), like ashcamp: clock on the left, "● MENU" on the right -->
	<div class="nav__bar">
		<span class="nav__clock" data-clock>
			<span class="nav__dot" data-clock-dot></span>
			<span class="nav__time" data-clock-time>--:--:-- --</span>
		</span>

		<button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
			<span class="nav__menu-dot" aria-hidden="true"></span>
			<span data-menu-label>MENU</span>
		</button>
	</div>

	<nav class="nav__panel" id="nav-panel" data-nav-panel aria-label="Menú">
		<!-- --i: position in the opening stagger (big links first, then email / LinkedIn) -->
		<div class="nav__panel-main">
			{links.map((link, i) => <a class="nav__panel-link" href={link.href} style={`--i:${i}`}>{link.label}</a>)}
			<a class="nav__panel-link" href="#contact" style={`--i:${links.length}`}>Hablemos</a>
		</div>

		<div class="nav__panel-meta">
			<button class="nav__panel-small nav__email" type="button" data-copy-email data-email={email} style={`--i:${links.length + 1}`}>
				<span class="swap">
					<span data-copy-label>{email}</span>
					<span aria-hidden="true">Copiado!</span>
				</span>
			</button>
			<a class="nav__panel-small" href={linkedin} target="_blank" rel="noreferrer" style={`--i:${links.length + 2}`}>LinkedIn</a>
		</div>
	</nav>
</header>

<!-- Entry gate for the mobile bar (same idea as the hero's): armed before the first paint, played once a
     frame has been painted, so the entrance is not spent while the page is still blank. No JS: no gate. -->
<script is:inline>
	(() => {
		const nav = document.querySelector("[data-nav]");
		if (!nav) return;
		nav.dataset.intro = "armed";
		requestAnimationFrame(() => requestAnimationFrame(() => (nav.dataset.intro = "play")));
	})();
</script>

<script>
	const nav = document.querySelector<HTMLElement>("[data-nav]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
	const label = document.querySelector<HTMLElement>("[data-menu-label]");
	const panel = document.querySelector<HTMLElement>("[data-nav-panel]");

	// hides while the contact section is on screen (slides up and fades), shows again when it leaves
	const contact = document.getElementById("contact");
	function syncHidden() {
		if (!nav || !contact) return;
		const r = contact.getBoundingClientRect();
		const reached = r.top <= 0.5 || (r.top >= 0 && r.bottom <= innerHeight + 0.5);
		nav.classList.toggle("is-hidden", reached && r.bottom > 0 && !nav.classList.contains("is-open"));
	}
	addEventListener("scroll", syncHidden, { passive: true });
	addEventListener("resize", syncHidden);
	syncHidden();

	function setOpen(open: boolean) {
		nav?.classList.toggle("is-open", open);
		toggle?.setAttribute("aria-expanded", String(open));
		if (label) label.textContent = open ? "CLOSE" : "MENU";
		document.documentElement.style.overflow = open ? "hidden" : "";
	}

	toggle?.addEventListener("click", () => setOpen(!nav?.classList.contains("is-open")));
	panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
	window.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setOpen(false);
	});
	// email button in the mobile menu: copy to the clipboard and show "Copiado!" for a moment
	document.querySelectorAll<HTMLButtonElement>(".nav [data-copy-email]").forEach((button) => {
		button.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.email ?? "");
			} catch {
				// Clipboard API unavailable; the label swap is cosmetic only.
			}
			button.classList.add("is-copied");
			setTimeout(() => button.classList.remove("is-copied"), 1500);
		});
	});

	// leaving the mobile layout while the menu is open: close it
	matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
		if (e.matches) setOpen(false);
	});

	// like ashcamp's instance: Buenos Aires time, "online" (green) from 10 to 18h, red otherwise
	const TZ = "America/Argentina/Buenos_Aires";
	const ONLINE_FROM = 10;
	const ONLINE_TO = 18;
	const formatter = new Intl.DateTimeFormat("en-US", {
		timeZone: TZ,
		hour: "2-digit",
		minute: "2-digit",
		second: "2-digit",
		hour12: true,
	});
	const hourFormatter = new Intl.DateTimeFormat("en-US", { timeZone: TZ, hour: "numeric", hour12: false });

	function tick() {
		const now = new Date();
		const text = formatter.format(now);
		const h = parseInt(hourFormatter.format(now), 10) % 24;
		document.querySelectorAll<HTMLElement>("[data-clock-time]").forEach((el) => (el.textContent = text));
		document
			.querySelectorAll<HTMLElement>("[data-clock-dot]")
			.forEach((el) => el.classList.toggle("is-online", h >= ONLINE_FROM && h < ONLINE_TO));
	}

	tick();
	setInterval(tick, 1000);
</script>

<style>
	/* in-flow slot: same height as the nav, only draws the frame lines */
	.nav-slot {
		min-height: var(--nav-h);
		border-bottom: none;
	}

	/* fixed transparent overlay aligned with the dashed frame (1px transparent borders match its lines) */
	.nav {
		position: fixed;
		top: calc(2 * var(--gutter)); /* 40px from the screen, 20px inside the dashed frame */
		left: var(--gutter);
		right: var(--gutter);
		max-width: var(--container);
		margin-inline: auto;
		z-index: 50;
		border-inline: 1px solid transparent;
		/* leaving: slides up 100px and fades (spring 300 / 30 in the reference, ~0.4s) */
		transition:
			transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.nav.is-hidden {
		transform: translateY(-100px);
		opacity: 0;
		pointer-events: none;
	}

	.nav :global(.col-narrow) {
		border-right: none;
	}

	/* the desktop nav row is exactly 44px tall; --sticky-top places the sticky titles below it */
	.nav__desktop {
		height: var(--nav-row-h);
	}

	.nav__desktop > .nav__links-cell,
	.nav__desktop > .nav__meta-cell {
		display: flex;
		align-items: center;
		padding-block: 0;
	}

	.nav__links {
		display: flex;
		gap: 24px;
		margin-inline-start: -8px; /* the links' padding is hit area: the text stays on the column's edge */
		font-family: var(--font-mono);
		font-size: 11px;
		text-transform: uppercase;
	}

	.nav__links a {
		position: relative;
		padding: 8px;
	}

	.nav__meta-cell {
		margin-inline-start: auto;
		gap: 64px; /* ashcamp: clock ↔ button */
		justify-content: flex-end;
	}

	/* ashcamp's clock: 10px dot + time, 12px apart */
	.nav__clock {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		white-space: nowrap;
	}

	.nav__dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		flex-shrink: 0;
		background: rgb(240, 0, 0);
	}

	.nav__dot.is-online {
		background: rgb(0, 204, 82);
	}

	.nav__time {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 400;
		font-style: normal;
		letter-spacing: -0.04em;
		line-height: 1em;
		color: #fff;
		user-select: none;
	}

	/* mobile pieces are hidden on desktop */
	.nav__bar,
	.nav__panel {
		display: none;
	}

	@media (max-width: 767.98px) {
		.nav__desktop {
			display: none;
		}

		.nav {
			top: 0;
		}

		.nav-slot > :global(*) {
			display: none;
		}

		/* ashcamp mobile: clock left, "● MENU" right, no divider */
		.nav__bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			min-height: var(--nav-h);
			padding: 40px 20px 0;
		}

		/* open, the panel already starts inside the frame: the bar's content stays where it was */
		.nav.is-open .nav__bar {
			padding-top: 0;
			margin-top: -1px; /* the open panel's border */
		}

		.nav__menu {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 8px;
			background: none;
			border: 0;
			color: #fff;
			font-family: var(--font-mono);
			font-size: 11px;
			font-weight: 400;
			line-height: 1em;
			text-transform: uppercase;
			cursor: pointer;
		}

		.nav__menu-dot {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: #fff;
		}

		/* open: the nav becomes a full-screen panel inside the same dashed frame */
		.nav.is-open {
			position: fixed;
			inset: var(--gutter);
			max-width: none;
			margin: 0;
			background: var(--bg);
			z-index: 100;
			height: auto;
			overflow-y: auto;
			border: var(--border);
			box-shadow: 0 0 0 var(--gutter) var(--bg);
		}

		.nav.is-open .nav__panel {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			padding: 16px 20px 24px;
		}

		.nav__panel-main,
		.nav__panel-meta {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
		}

		/* big links: ashcamp's "Mobile" link variant → 28px / 1.2em, 8px padding, PP Telegraf */
		.nav__panel-link {
			padding: 8px;
			font-family: "PP Telegraf Regular", "PP Telegraf", "Hanken Grotesk", var(--font-display), sans-serif;
			font-size: 28px;
			font-weight: 400;
			line-height: 1.2em;
			letter-spacing: 0;
			text-transform: uppercase;
			color: #fff;
		}

		/* email / LinkedIn: 11px Martian Mono, 40px below the big links, 15px apart */
		.nav__panel-meta {
			gap: 15px;
			margin-top: 40px;
		}

		.nav__panel-small {
			padding: 8px;
			background: none;
			border: 0;
			font-family: var(--font-mono);
			font-size: 11px;
			font-weight: 400;
			line-height: 1.2em;
			text-transform: uppercase;
			color: #fff;
			cursor: pointer;
		}

		.nav__email.is-copied :global(.swap) > :global(span) {
			transform: translateY(-100%);
		}

		/* touch feedback: phones have no hover, so pressing a menu item dims it while held */
		.nav__menu,
		.nav__panel-link,
		.nav__panel-small {
			-webkit-tap-highlight-color: transparent;
			transition: opacity 0.2s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.nav__menu:active,
		.nav__panel-link:active,
		.nav__panel-small:active {
			opacity: 0.55;
			transition-duration: 0s;
		}

		/* entrance of the bar (clock + MENU) on load: same rise + fade as the rest of the site, slightly
		   staggered; held while the gate is armed, played after the first painted frame */
		.nav[data-intro="armed"] .nav__bar > * {
			opacity: 0;
		}

		.nav[data-intro="play"] .nav__bar > * {
			animation: nav-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: 0.1s;
			--rise: 12px;
		}

		.nav[data-intro="play"] .nav__bar > :last-child {
			animation-delay: 0.18s;
		}

		/* opening the menu: the panel goes from display:none to flex, so these replay on every open.
		   Big links first, then email / LinkedIn, 50ms apart. */
		.nav.is-open .nav__panel-link,
		.nav.is-open .nav__panel-small {
			--rise: 40px;
			/* backwards, not both: once done the items fall back to their own styles, so :active can dim them */
			animation: nav-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: calc(0.06s + var(--i, 0) * 0.05s);
		}
	}

	@keyframes nav-rise {
		from {
			opacity: 0;
			transform: translateY(var(--rise, 40px));
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* touch screens: the shared hover-swap would stick after a tap (a tapped element keeps :hover), which
	   left the email showing "Copiado!" indefinitely; only the explicit .is-copied state swaps it */
	@media (hover: none) {
		.nav__email:not(.is-copied) :global(.swap) > :global(span) {
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav[data-intro] .nav__bar > * {
			animation: none;
			opacity: 1;
		}

		.nav.is-open .nav__panel-link,
		.nav.is-open .nav__panel-small {
			animation: none;
		}
	}
</style>

---
import HalftoneBackground from "./HalftoneBackground.astro";
import ChatButton from "./ChatButton.astro";

const links = [
	{ href: "/#index", label: "Index" },
	{ href: "/#work", label: "Work" },
	{ href: "/#info", label: "Info" },
];
---

<header class="nav frame" data-nav>
	<HalftoneBackground mode="nav" />

	<!-- desktop (≥ 810px) -->
	<div class="split nav__desktop">
		<div class="col-narrow nav__links-cell">
			<nav class="nav__links">
				{links.map((link) => (
					<a href={link.href}>
						<span class="swap">
							<span>{link.label}</span>
							<span aria-hidden="true">{link.label}</span>
						</span>
					</a>
				))}
			</nav>
		</div>

		<div class="col-wide nav__meta-cell">
			<span class="nav__clock" data-clock>
				<span class="nav__dot" data-clock-dot></span>
				<span class="nav__time" data-clock-time>--:--:-- --</span>
			</span>

			<ChatButton href="#contact" label="Hablemos" ariaLabel="Hablemos: ir a contacto" />
		</div>
	</div>

	<!-- mobile (< 810px), like ashcamp: clock on the left, "● MENU" on the right -->
	<div class="nav__bar">
		<span class="nav__clock" data-clock>
			<span class="nav__dot" data-clock-dot></span>
			<span class="nav__time" data-clock-time>--:--:-- --</span>
		</span>

		<button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
			<span class="nav__menu-dot" aria-hidden="true"></span>
			<span data-menu-label>MENU</span>
		</button>
	</div>

	<nav class="nav__panel" id="nav-panel" data-nav-panel aria-label="Menú">
		{links.map((link) => <a class="nav__panel-link" href={link.href}>{link.label}</a>)}
		<ChatButton href="#contact" label="Hablemos" ariaLabel="Hablemos: ir a contacto" />
	</nav>
</header>

<script>
	const nav = document.querySelector<HTMLElement>("[data-nav]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
	const label = document.querySelector<HTMLElement>("[data-menu-label]");
	const panel = document.querySelector<HTMLElement>("[data-nav-panel]");

	function setOpen(open: boolean) {
		nav?.classList.toggle("is-open", open);
		toggle?.setAttribute("aria-expanded", String(open));
		if (label) label.textContent = open ? "CLOSE" : "MENU";
		document.documentElement.style.overflow = open ? "hidden" : "";
	}

	toggle?.addEventListener("click", () => setOpen(!nav?.classList.contains("is-open")));
	panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
	window.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setOpen(false);
	});
	// leaving the mobile layout while the menu is open: close it
	matchMedia("(min-width: 810px)").addEventListener("change", (e) => {
		if (e.matches) setOpen(false);
	});

	const formatter = new Intl.DateTimeFormat("en-US", {
		hour: "2-digit",
		minute: "2-digit",
		second: "2-digit",
		hour12: true,
	});

	// like ashcamp: green while "online" (working hours), red otherwise
	const ONLINE_FROM = 9;
	const ONLINE_TO = 18;

	function tick() {
		const now = new Date();
		const text = formatter.format(now);
		const h = now.getHours();
		document.querySelectorAll<HTMLElement>("[data-clock-time]").forEach((el) => (el.textContent = text));
		document
			.querySelectorAll<HTMLElement>("[data-clock-dot]")
			.forEach((el) => el.classList.toggle("is-online", h >= ONLINE_FROM && h < ONLINE_TO));
	}

	tick();
	setInterval(tick, 1000);
</script>

<style>
	/* the halftone canvas sits behind the nav content */
	.nav > :global(.split),
	.nav__bar,
	.nav__panel {
		position: relative;
		z-index: 1;
	}

	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--bg);
		border-bottom: none; /* ashcamp has no divider between the nav and the hero */
	}

	.nav__desktop {
		min-height: var(--nav-h);
	}

	.nav__links-cell,
	.nav__meta-cell {
		display: flex;
		align-items: center;
	}

	.nav__links {
		display: flex;
		gap: 20px;
		font-family: var(--font-mono);
		font-size: 11px;
		text-transform: uppercase;
	}

	.nav__links a {
		position: relative;
	}

	.nav__meta-cell {
		margin-inline-start: auto;
		gap: 64px; /* ashcamp: clock ↔ button */
		justify-content: flex-end;
	}

	/* ashcamp's clock: 10px dot + time, 12px apart */
	.nav__clock {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		white-space: nowrap;
	}

	.nav__dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		flex-shrink: 0;
		background: rgb(240, 0, 0);
	}

	.nav__dot.is-online {
		background: #22cc66;
	}

	.nav__time {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 400;
		font-style: normal;
		letter-spacing: -0.04em;
		line-height: 1em;
		color: #fff;
		user-select: none;
	}

	/* mobile pieces are hidden on desktop */
	.nav__bar,
	.nav__panel {
		display: none;
	}

	@media (max-width: 809.98px) {
		.nav__desktop {
			display: none;
		}

		/* ashcamp mobile: clock left, "● MENU" right, no divider */
		.nav__bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			min-height: var(--nav-h);
			padding: 0 28px 0 20px;
		}

		.nav__menu {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 0;
			background: none;
			border: 0;
			color: #fff;
			font-family: var(--font-mono);
			font-size: 11px;
			font-weight: 400;
			line-height: 1em;
			text-transform: uppercase;
			cursor: pointer;
		}

		.nav__menu-dot {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: #fff;
		}

		/* open: the nav becomes a full-screen panel inside the same dashed frame */
		.nav.is-open {
			position: fixed;
			inset: var(--gutter);
			z-index: 100;
			height: auto;
			overflow-y: auto;
			border: var(--border);
			box-shadow: 0 0 0 var(--gutter) var(--bg);
		}

		.nav.is-open .nav__panel {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 10px; /* ashcamp: 29px rows, 10px apart */
			padding: 40px 20px 24px;
		}

		.nav__panel-link {
			font-family: var(--font-mono);
			font-size: 11px;
			line-height: 29px;
			text-transform: uppercase;
			color: var(--fg);
		}
	}
</style>

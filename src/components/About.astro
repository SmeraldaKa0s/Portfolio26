---
import { Image } from "astro:assets";
import profile from "../assets/foto-arqueria.jpg";
import { about } from "../content/site";

const { paragraphs, capabilities } = about;
---

<section id="info" class="frame">
	<div class="split">
		<div class="col-narrow section-head">
			<h2 class="section-title" data-scroll-reveal>{about.title}</h2>
		</div>

		<div class="col-wide about__cell">
			<!-- same size as the images in Work -->
			<div class="about__image" data-reveal data-photo-trail>
				<Image
					src={profile}
					alt="Retrato de Alexandra Lerner"
					widths={[640, 960, 1280, 1920]}
					sizes="(min-width: 1200px) 60vw, 100vw"
					loading="eager"
					draggable="false"
				/>
				<!-- iridescent cursor trail (src/scripts/photoTrail.ts); the img shows until it draws -->
				<canvas aria-hidden="true"></canvas>
			</div>

			<div class="about__text">
				<div class="about__lead">
					<h1 class="about__statement" data-scroll-reveal>
						{about.statement}
					</h1>

					<!-- the paragraphs reveal together, as one block -->
					<div class="about__bio" data-scroll-reveal>
						{paragraphs.map((text) => <p>{text}</p>)}
					</div>
				</div>

				<div class="about__capabilities">
					<h6 class="about__label" data-scroll-reveal>{about.capabilitiesTitle}</h6>
					{capabilities.map((item) => <p class="about__item" data-scroll-reveal>{item}</p>)}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { startPhotoTrail } from "../scripts/photoTrail";

	document.querySelectorAll<HTMLElement>("[data-photo-trail]").forEach(startPhotoTrail);
</script>

<style>
	/* media-side cell: 60px padding (40px tablet, 40/20 mobile), content stacked with 60px between blocks */
	.about__cell {
		min-width: 0; /* the photo's intrinsic width must not stretch the column */
		display: flex;
		flex-direction: column;
		gap: 60px;
		padding: 60px;
	}

	/* same 8:5 box as the Work images; the photo is portrait (3:4), so it's cropped to that box */
	.about__image {
		position: relative;
		width: 100%;
		aspect-ratio: 8 / 5;
		overflow: hidden;
		border-radius: 10px;
	}

	.about__image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: 100%;
		/* deterrent: no right-click "open image in new tab", drag-out or long-press save on the photo */
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
		object-fit: cover;
		object-position: 50% 55.9%;
		border-radius: 10px;
	}

	.about__image canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 0;
	}

	.about__image:global(.is-gl) canvas {
		opacity: 1;
	}

	.about__text {
		display: flex;
		flex-direction: column;
		gap: 60px;
	}

	.about__lead,
	.about__capabilities {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	/* statement ↔ bio: 24px */
	.about__lead {
		gap: 24px;
	}

	/* label ↔ items, and item ↔ item: 10px */
	.about__capabilities {
		gap: 10px;
	}

	/* h1 preset: sans 40px (28px below 1200), 1.2em, white, 640px max */
	.about__statement {
		width: 100%;
		max-width: 640px;
		margin: 0;
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 40px;
		line-height: 1.2em;
		letter-spacing: 0;
		color: var(--fg);
	}

	/* body preset: sans 16px (13px below 1200), 1.2em, #666 */
	.about__bio,
	.about__item {
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.2em;
		letter-spacing: 0;
		color: #666;
	}

	.about__bio {
		width: 100%;
		max-width: 640px;
	}

	.about__bio p {
		margin: 0 0 20px; /* paragraph spacing is a fixed 20px, not tied to the font size */
	}

	.about__bio p:last-child {
		margin-bottom: 0;
	}

	.about__item {
		margin: 0;
	}

	.about__label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 400;
		line-height: 1.2em;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--fg);
	}

	@media (max-width: 1199.98px) {
		.about__cell {
			padding: 40px;
		}

		.about__statement {
			font-size: 28px;
		}

		.about__bio,
		.about__item {
			font-size: 13px;
		}
	}

	@media (max-width: 767.98px) {
		.about__cell {
			padding: 40px 20px;
		}
	}
</style>

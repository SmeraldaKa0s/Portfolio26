---
import { Image } from "astro:assets";
import profile from "../assets/foto-perfil.png";

const paragraphs = [
	"Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore.",
	"Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat, duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore.",
	"Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum. Sed ut perspiciatis unde omnis iste natus error sit voluptatem.",
	"Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt.",
];

const capabilities = [
	"Product Design",
	"Web Design",
	"Prototipado con IA",
	"Estrategia de producto",
	"Design Systems",
	"Proyectos 0→1",
	"Investigación de usuarios",
];
---

<section id="info" class="frame">
	<div class="split">
		<div class="col-narrow section-head">
			<h2 class="section-title" data-reveal>Info</h2>
		</div>

		<div class="col-wide about__cell">
			<!-- same size as the images in Work -->
			<div class="about__image" data-reveal>
				<Image
					src={profile}
					alt="Retrato de Alexandra Lerner"
					widths={[640, 960, 1280]}
					sizes="(min-width: 1200px) 60vw, 100vw"
					loading="eager"
					draggable="false"
				/>
			</div>

			<div class="about__text">
				<div class="about__lead">
					<h1 class="about__statement" data-reveal>
						Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor.
					</h1>

					<div class="about__bio">
						{paragraphs.map((text) => <p data-reveal>{text}</p>)}
					</div>
				</div>

				<div class="about__capabilities">
					<h6 class="about__label" data-reveal>Capacidades</h6>
					{capabilities.map((item) => <p class="about__item" data-reveal>{item}</p>)}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* media-side cell: 60px padding (40px tablet, 40/20 mobile), content stacked with 60px between blocks */
	.about__cell {
		min-width: 0; /* the photo's intrinsic width must not stretch the column */
		display: flex;
		flex-direction: column;
		gap: 60px;
		padding: 60px;
	}

	/* the photo is already 8:5 (1586×992), so it fills the same box as the Work images with no crop */
	.about__image {
		width: 100%;
		aspect-ratio: 8 / 5;
		overflow: hidden;
		border-radius: 10px;
	}

	.about__image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: 100%;
		/* deterrent: no right-click "open image in new tab", drag-out or long-press save on the photo */
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
		object-fit: cover;
		object-position: 50% 50%;
		border-radius: 10px;
	}

	.about__text {
		display: flex;
		flex-direction: column;
		gap: 60px;
	}

	.about__lead,
	.about__capabilities {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
	}

	/* h1 preset: sans 40px (28px below 1200), 1.2em, white, 640px max */
	.about__statement {
		width: 100%;
		max-width: 640px;
		margin: 0;
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 40px;
		line-height: 1.2em;
		letter-spacing: 0;
		color: var(--fg);
	}

	/* body preset: sans 16px (13px below 1200), 1.2em, #666 */
	.about__bio,
	.about__item {
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.2em;
		letter-spacing: 0;
		color: #666;
	}

	.about__bio {
		width: 100%;
		max-width: 640px;
	}

	.about__bio p {
		margin: 0 0 1.2em;
	}

	.about__bio p:last-child {
		margin-bottom: 0;
	}

	.about__item {
		margin: 0;
	}

	.about__label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 400;
		line-height: 1.2em;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--fg);
	}

	@media (max-width: 1199.98px) {
		.about__cell {
			padding: 40px;
		}

		.about__statement {
			font-size: 28px;
		}

		.about__bio,
		.about__item {
			font-size: 13px;
		}
	}

	@media (max-width: 767.98px) {
		.about__cell {
			padding: 40px 20px;
		}
	}
</style>

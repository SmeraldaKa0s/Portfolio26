---
const capabilities = [
	"Product Design",
	"Web Design",
	"Prototipado con IA",
	"Estrategia de producto",
	"Design Systems",
	"Proyectos 0→1",
	"Investigación de usuarios",
];
---

<section id="info" class="frame">
	<div class="split">
		<div class="col-narrow">
			<p class="eyebrow">Info</p>
		</div>

		<div class="col-wide about__content">
			<h2 class="about__statement" data-reveal>
				Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.
			</h2>

			<p class="about__bio" data-reveal>
				Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
				tempor incididunt ut labore et dolore magna aliqua, ut enim ad minim
				veniam quis nostrud exercitation ullamco laboris nisi ut aliquip.
			</p>

			<ul class="about__capabilities" data-reveal-group>
				{capabilities.map((item) => <li data-reveal>{item}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	.about__content {
		padding-block: 48px;
	}

	.about__statement {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 20px;
		line-height: 1.3;
		max-width: 28ch;
		margin: 0 0 24px;
	}

	.about__bio {
		font-size: 16px;
		color: var(--muted);
		max-width: 60ch;
		margin: 0 0 32px;
	}

	.about__capabilities {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		list-style: none;
		padding: 0;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11px;
		text-transform: uppercase;
	}

	.about__capabilities li {
		border: var(--border);
		border-radius: 100px;
		padding: 8px 16px;
		color: var(--muted);
	}
</style>

---
import { experience } from "../content/site";

const { roles } = experience;
---

<section class="frame">
	<div class="split">
		<div class="col-narrow section-head">
			<h2 class="section-title" data-reveal>{experience.title}</h2>
		</div>

		<div class="col-wide experience__cell">
			{roles.map((item) => (
				<div class="experience__row">
					<div class="experience__main">
						<p class="experience__title" data-reveal>{item.title}</p>
						<p class="experience__text" data-reveal>{item.text}</p>
					</div>
					<p class="experience__dates" data-reveal>{item.dates}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	/* media-side cell: 60px padding (40px tablet, 40/20 mobile), rows pushed to the bottom */
	.experience__cell {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 60px;
	}

	/* each row: 20px / 0 padding, solid 1px #222 line underneath */
	.experience__row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		padding: 20px 0;
		border-bottom: 1px solid #222;
	}

	.experience__main {
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: 1 0 0;
		max-width: 400px;
	}

	.experience__title,
	.experience__text,
	.experience__dates {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.2em;
		letter-spacing: 0;
		color: #666;
	}

	.experience__title {
		color: var(--fg);
	}

	.experience__dates {
		white-space: pre;
	}

	@media (max-width: 1199.98px) {
		.experience__cell {
			padding: 40px;
		}

		.experience__title,
		.experience__text,
		.experience__dates {
			font-size: 13px;
		}
	}

	@media (max-width: 767.98px) {
		.experience__cell {
			padding: 40px 20px;
		}

		.experience__row {
			justify-content: flex-start;
			gap: 24px;
		}
	}
</style>

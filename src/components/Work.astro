---
import { getCollection } from "astro:content";
import Media from "./Media.astro";

const projects = (await getCollection("projects")).sort(
	(a, b) => a.data.order - b.data.order
);
---

<section id="work" class="frame work">
	{projects.map((project, i) => (
		<a
			href={`/proyectos/${project.id}`}
			class="split work__item"
			style={i !== projects.length - 1 ? "border-bottom: var(--border)" : ""}
		>
			<div class="col-narrow work__item-text">
				<div class="work__item-sticky">
					<h3 data-reveal>{project.data.title}</h3>
					<p data-reveal>{project.data.excerpt}</p>
					<span class="work__tag" data-reveal>{project.data.category}</span>
				</div>
			</div>

			<div class="col-wide work__item-media">
				<div class="work__shot work__shot--full" data-reveal><Media kind={project.data.media.kind} ratio="8 / 5" /></div>
				<div class="work__shot" data-reveal><Media kind="image" ratio="3 / 4" /></div>
				<div class="work__shot" data-reveal><Media kind="image" ratio="3 / 4" /></div>
				<div class="work__shot work__shot--full" data-reveal><Media kind="image" ratio="8 / 5" /></div>
			</div>
		</a>
	))}
</section>

<style>
	/* stretch (not center) so the text column's right border runs the full height of the row:
	   the vertical dashed line stays continuous */
	.work__item {
		align-items: stretch;
	}

	/* text cell: 80px / 20px padding; the block stays pinned 20px under the nav (20px gutter + 44px nav) while the media scrolls */
	.work__item > .work__item-text {
		padding: 80px 20px;
	}

	.work__item-sticky {
		position: sticky;
		top: var(--sticky-top);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
	}

	/* ashcamp: title 20px (16px below 1200), description 14px #666, tag as a #222 pill */
	.work__item-text h3 {
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 20px;
		line-height: 1.2em;
		letter-spacing: 0;
		margin: 0;
	}

	.work__item-text p {
		font-family: var(--font-sans);
		font-size: 14px;
		line-height: 1.4;
		color: #666;
		margin: 0;
		max-width: 32ch;
	}

	.work__tag {
		display: inline-flex;
		align-items: center;
		width: min-content;
		white-space: nowrap;
		padding: 4px 12px;
		border-radius: 100px;
		background: #222;
		font-family: var(--font-sans);
		font-size: 11px;
		line-height: 1.2em;
		color: var(--fg);
		opacity: 0.64;
	}

	/* media cell: 60px padding (40px on tablet), media pushed to the bottom-right */
	.work__item > .work__item-media {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-content: end;
		gap: 10px;
		padding: 60px;
		overflow: hidden;
	}

	/* three rows per project: full width, two side by side, full width */
	.work__shot--full {
		grid-column: 1 / -1;
	}

	.work__item-media :global(.placeholder-media) {
		width: 100%;
	}

	.work__item-media :global(.placeholder-media) {
		border-radius: 10px;
	}

	@media (max-width: 1199.98px) {
		.work__item-text h3 {
			font-size: 16px;
		}

		.work__item > .work__item-media {
			padding: 40px;
		}
	}

	/* mobile: one column — text cell (80/20 padding, dashed bottom line) then the media
	   cell (40/20 padding); the frame's left/right dashed lines run on both sides */
	@media (max-width: 767.98px) {
		.work__item > .work__item-text {
			flex: none;
			max-width: none;
			border-right: none;
			border-bottom: var(--border);
		}

		.work__item-text p {
			max-width: none;
		}

		.work__item-sticky {
			position: static;
		}

		.work__item > .work__item-media {
			flex: none;
			padding: 40px 20px;
		}
	}
</style>

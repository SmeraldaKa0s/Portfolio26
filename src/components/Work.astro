---
import { getCollection } from "astro:content";
import Media from "./Media.astro";

// temporary: only the first projects are shown, to keep the page short while working on it.
// The camera journey in scripts/workOrbit.ts is tuned for 3: more projects need its orbit retuned.
const VISIBLE_PROJECTS = 3;

const projects = (await getCollection("projects"))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, VISIBLE_PROJECTS);
---

<section id="work" class="journey" data-journey aria-label="Proyectos">
	<!-- 3D only if WebGL2 is there and motion is allowed; otherwise, and without JS, this is a plain list.
	     Set before the first paint so the page's height doesn't jump. -->
	<script is:inline>
		(() => {
			const journey = document.querySelector("[data-journey]");
			if (!journey || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			if (document.createElement("canvas").getContext("webgl2")) journey.classList.add("is-3d");
		})();
	</script>

	<div class="journey__pin" data-journey-pin>
		<canvas class="journey__field" data-journey-field aria-hidden="true"></canvas>
		<div class="journey__lines" data-journey-lines aria-hidden="true"></div>

		<div class="journey__stage" data-journey-stage>
			{projects.map((project) => (
				<article class="journey__project">
					<!-- mouse target over the video; the caption holds the link for keyboard and screen readers -->
					<a
						href={`/proyectos/${project.id}`}
						class="journey__panel"
						data-journey-panel
						tabindex="-1"
						aria-hidden="true"
					>
						<!-- three rows per project: full width, two side by side, full width -->
						<div class="journey__shot journey__shot--full" data-journey-shot><Media
								kind={project.data.media.kind}
								ratio="8 / 5"
								src={project.data.media.src}
								poster={project.data.media.poster}
								background={project.data.media.background}
								alt={project.data.title}
							/></div>
						<div class="journey__shot" data-journey-shot><Media kind="image" ratio="3 / 4" /></div>
						<div class="journey__shot" data-journey-shot><Media kind="image" ratio="3 / 4" /></div>
						<div class="journey__shot journey__shot--full" data-journey-shot><Media kind="image" ratio="8 / 5" /></div>
					</a>

					<div class="journey__cap" data-journey-cap>
						<h3 data-journey-part>{project.data.title}</h3>
						<p data-journey-part>{project.data.excerpt}</p>
						<div class="journey__meta" data-journey-part>
							<span class="journey__tag">{project.data.category}</span>
							<a class="journey__go" href={`/proyectos/${project.id}`}>
								Ver proyecto
								<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
									<path d="M4.5 2.5 8 6l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
								</svg>
							</a>
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<script>
	import "../scripts/workOrbit";
</script>

<style>
	/* ---- plain list: no JS, no WebGL2, or reduced motion ---- */
	.journey__field,
	.journey__lines {
		display: none;
	}

	.journey__project {
		display: flex;
		flex-direction: row-reverse;
		border-block: var(--border);
	}

	.journey__project + .journey__project {
		border-top: none;
	}

	.journey__panel {
		flex: 1 0 0;
		min-width: 0;
		padding: 60px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-content: start;
		gap: 10px;
	}

	.journey__shot--full {
		grid-column: 1 / -1;
	}

	.journey__cap {
		flex: 0 0 var(--col-narrow-w);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		padding: 80px 20px;
		border-right: var(--border);
	}

	/* ---- camera journey: workOrbit.ts sets the final height from the images' size ---- */
	.journey.is-3d {
		position: relative;
		height: 720vh;
	}

	.is-3d .journey__pin {
		position: sticky;
		top: 0;
		height: 100vh;
		height: 100svh;
		/* full width of the screen: it covers the page's dashed frame, redrawn below so it can fade */
		width: 100vw;
		margin-left: calc(50% - 50vw);
		overflow: hidden;
		background: var(--bg);
	}

	.is-3d .journey__field {
		display: block;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.is-3d .journey__lines {
		display: block;
		position: absolute;
		top: 0;
		bottom: 0;
		border-inline: var(--border);
		pointer-events: none;
	}

	.is-3d .journey__lines::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--col);
		border-left: var(--border);
	}

	.is-3d .journey__stage {
		position: absolute;
		inset: 0;
	}

	.is-3d .journey__project {
		display: contents;
	}

	/* placed by the camera in workOrbit.ts; 900px wide = 3 world units. The top margin centres the first image */
	.is-3d .journey__panel {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 900px;
		margin-left: -450px;
		padding: 0;
		backface-visibility: hidden;
		visibility: hidden;
	}

	.journey__panel :global(.placeholder-media) {
		width: 100%;
	}

	.is-3d .journey__cap {
		position: absolute;
		z-index: 2000;
		left: var(--cap-left, 40px);
		top: var(--sticky-top);
		width: var(--cap-width, 300px);
		padding: 0;
		border: 0;
		opacity: 0;
		pointer-events: none;
		transform-origin: 0 0;
	}

	.is-3d .journey__cap :global(.journey__word),
	.is-3d .journey__cap :global(.journey__char) {
		display: inline-block;
		white-space: nowrap;
	}

	.is-3d .journey__cap :global(.journey__read) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.is-3d .journey__cap:focus-within,
	.is-3d .journey__cap:focus-within [data-journey-part],
	.is-3d .journey__cap:focus-within :global(.journey__char) {
		opacity: 1 !important;
		filter: none !important;
		transform: none !important;
	}

	/* ---- caption ---- */
	.journey__cap h3 {
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 20px;
		line-height: 1.2em;
		letter-spacing: 0;
		margin: 0;
	}

	.journey__cap p {
		font-family: var(--font-sans);
		font-size: 14px;
		line-height: 1.4;
		color: #666;
		margin: 0;
		max-width: 32ch;
	}

	/* tag + "Ver proyecto" side by side */
	.journey__meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	/* Subtle button. Rest: --muted text (#8a8a8a on #0a0a0a ≈ 5.6:1) with a chevron, no background.
	   Hover / keyboard focus: --border-color (#222) pill with --fg text (≈ 15:1). Both pass WCAG AA
	   for small text; the state also changes shape (background), not colour alone. */
	.journey__go {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 28px;
		padding: 4px 10px 4px 12px;
		border-radius: 100px;
		background: transparent;
		font-family: var(--font-sans);
		font-size: 11px;
		line-height: 1.2em;
		white-space: nowrap;
		color: var(--muted);
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.journey__go svg {
		flex-shrink: 0;
		transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
	}

	@media (hover: hover) {
		.journey__go:hover {
			background: var(--border-color);
			color: var(--fg);
		}

		.journey__go:hover svg {
			transform: translateX(2px);
		}
	}

	.journey__go:focus-visible {
		background: var(--border-color);
		color: var(--fg);
	}

	.journey__tag {
		display: inline-flex;
		align-items: center;
		width: min-content;
		white-space: nowrap;
		padding: 4px 12px;
		border-radius: 100px;
		background: #222;
		font-family: var(--font-sans);
		font-size: 11px;
		line-height: 1.2em;
		color: var(--fg);
		opacity: 0.64;
	}

	@media (max-width: 1199.98px) {
		.journey__cap h3 {
			font-size: 16px;
		}

		.journey__panel {
			padding: 40px;
		}
	}

	@media (max-width: 767.98px) {
		.journey__project {
			flex-direction: column-reverse;
		}

		.journey__panel {
			flex: none;
			padding: 40px 20px;
		}

		.journey__cap {
			flex: none;
			border-right: none;
			border-bottom: var(--border);
		}

		.journey__cap p {
			max-width: none;
		}

		/* the images scroll beneath it on phones: a solid base keeps it readable */
		.is-3d .journey__cap {
			left: 0;
			right: 0;
			top: auto;
			bottom: 0;
			width: auto;
			padding: 56px 20px 28px;
			background: linear-gradient(to bottom, transparent, var(--bg) 40px);
		}
	}
</style>

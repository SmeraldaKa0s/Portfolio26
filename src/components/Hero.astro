---
---

<section id="index" class="hero frame">
	<div class="split hero__main">
		<div class="dot-texture" aria-hidden="true"></div>
		<div class="dot-glow" aria-hidden="true"></div>
		<canvas class="hero__butterfly" aria-hidden="true"></canvas>

		<div class="col-narrow hero__spacer" aria-hidden="true"></div>
		<div class="col-wide hero__headline-cell">
			<h1 class="hero__headline hero__intro">
				<strong>Lorem</strong> ipsum dolor sit amet,<br />
				consectetur adipiscing elit,<br />
				sed do eiusmod,<br />
				tempor incididunt ut labore et dolore.
			</h1>
		</div>
	</div>

	<div class="hero__footer">
		<span class="eyebrow hero__intro" style="--intro-delay: 0.3s">( Lorem Ipsum )</span>
		<span class="eyebrow hero__intro" style="--intro-delay: 0.38s">* Dolor Sit Amet *</span>
		<span class="eyebrow hero__intro" style="--intro-delay: 0.46s">( Consectetur )</span>
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		flex: 1 0 auto;
	}

	.hero__main {
		position: relative;
		flex: 1;
		overflow: hidden;
	}

	.hero__butterfly {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.hero__headline-cell {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		padding: 80px 48px;
	}

	.hero__headline {
		font-family: var(--font-mono-read);
		font-weight: 400;
		font-size: 14px;
		line-height: 1.2;
		color: #666666;
		margin: 0;
	}

	.hero__headline strong {
		font-weight: 400;
		color: var(--fg);
	}

	/* Hero content is always on-screen on load, so it fades in on a timer
	   instead of the scroll-triggered [data-reveal] used elsewhere. */
	.hero__intro {
		opacity: 0;
		transform: translateY(16px);
		animation: hero-intro 0.8s ease forwards;
		animation-delay: var(--intro-delay, 0.1s);
	}

	@keyframes hero-intro {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__intro {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	.hero__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px 20px;
		border-top: var(--border);
	}

	@media (max-width: 767.98px) {
		.hero__spacer {
			display: none;
		}

		.hero__headline-cell {
			padding: 48px 20px;
		}

		.hero__footer {
			flex-direction: column;
			gap: 8px;
			align-items: flex-start;
			padding: 16px 20px 24px;
		}
	}
</style>

<script>
	const canvas = document.querySelector('.hero__butterfly') as HTMLCanvasElement | null;
	const ctx = canvas?.getContext('2d');

	if (canvas && ctx) {
		const RAMP = ' .:-=+*#%@';
		const FONT_PX = 11;
		const FONT = `${FONT_PX}px "Fragment Mono", ui-monospace, Menlo, Consolas, monospace`;
		let rgb = '245, 245, 243';
		let CW = 6.6; // ancho de celda, se mide con la fuente real
		const CH = 11; // alto de celda
		const SIZE = 110; // tamaño de la mariposa en px (mitad del alto)
		const FADE = 0.78; // cuánto se mantiene la estela por frame
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let W = 0;
		let H = 0;
		let cols = 0;
		let rows = 0;
		let trail = new Float32Array(0);

		function resize() {
			const dpr = window.devicePixelRatio || 1;
			ctx!.font = FONT;
			CW = ctx!.measureText('M').width || CW;
			rgb = getComputedStyle(document.documentElement).getPropertyValue('--fg-rgb').trim() || rgb;
			W = canvas!.clientWidth;
			H = canvas!.clientHeight;
			canvas!.width = W * dpr;
			canvas!.height = H * dpr;
			ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
			cols = Math.ceil(W / CW);
			rows = Math.ceil(H / CH);
			trail = new Float32Array(cols * rows);
		}

		// Elipse rotada: devuelve 0..1 (1 = centro) o 0 si queda afuera.
		function lobe(u: number, v: number, cx: number, cy: number, rx: number, ry: number, rot: number) {
			const dx = u - cx;
			const dy = v - cy;
			const c = Math.cos(rot);
			const s = Math.sin(rot);
			const x = (dx * c + dy * s) / rx;
			const y = (-dx * s + dy * c) / ry;
			const d = x * x + y * y;
			return d < 1 ? d : -1; // d = 0 centro, ->1 borde
		}

		// Brillo (0..1) de la mariposa en coords locales; k = apertura de alas.
		function sample(u: number, v: number, k: number) {
			// cuerpo (no se aplana con el aleteo)
			const body = Math.abs(u) < 0.045 && v > -0.62 && v < 0.5;
			const head = u * u + (v - 0.55) * (v - 0.55) < 0.0045;
			if (body || head) return 1;

			const au = Math.abs(u) / k;
			let b = 0;

			const up = lobe(au, v, 0.5, 0.36, 0.62, 0.36, 0.5);
			if (up >= 0) {
				// borde más denso, interior con venas y una mancha
				let t = 0.25 + 0.55 * up * up + 0.12 * Math.sin(au * 18 + v * 9);
				const eye = (au - 0.62) ** 2 + (v - 0.42) ** 2;
				if (eye < 0.012) t = 0.95;
				else if (eye < 0.03) t = 0.12;
				b = Math.max(b, t);
			}
			const lo = lobe(au, v, 0.34, -0.36, 0.4, 0.3, -0.45);
			if (lo >= 0) {
				const t = 0.2 + 0.6 * lo * lo + 0.1 * Math.sin(au * 16 - v * 10);
				b = Math.max(b, t);
			}

			// antenas
			const ax = Math.abs(u);
			if (v > 0.58 && v < 0.95 && Math.abs(ax - (v - 0.58) * 0.55) < 0.03) b = Math.max(b, 0.7);
			return Math.min(b, 1);
		}

		let prevX = 0;
		let prevY = 0;
		let tilt = 0;

		function frame(now: number) {
			const t = now / 1000;
			const phase = t * 9; // frecuencia del aleteo
			const k = Math.max(0.14, Math.abs(Math.cos(phase)));

			// camino de vuelo: Lissajous suave + temblor del vuelo
						const bx = W * (0.5 + 0.38 * Math.sin(t * 0.37) + 0.06 * Math.sin(t * 0.91 + 1));
			const by = H * (0.5 + 0.28 * Math.sin(t * 0.53 + 1) + 0.04 * Math.sin(t * 1.3)) + 8 * Math.sin(phase * 2);
			const vx = bx - prevX;
			const vy = by - prevY;
			prevX = bx;
			prevY = by;
			const targetTilt = Math.max(-0.5, Math.min(0.5, vx * 0.08)) + Math.max(-0.2, Math.min(0.2, vy * 0.02));
			tilt += (targetTilt - tilt) * 0.1;
			const cos = Math.cos(tilt);
			const sin = Math.sin(tilt);

			// estela: todo decae y se suma la mariposa actual
			for (let i = 0; i < trail.length; i++) trail[i] *= FADE;

			const reach = SIZE * 1.3;
			const c0 = Math.max(0, Math.floor((bx - reach) / CW));
			const c1 = Math.min(cols - 1, Math.ceil((bx + reach) / CW));
			const r0 = Math.max(0, Math.floor((by - reach) / CH));
			const r1 = Math.min(rows - 1, Math.ceil((by + reach) / CH));
			for (let r = r0; r <= r1; r++) {
				for (let c = c0; c <= c1; c++) {
					const x = (c + 0.5) * CW - bx;
					const y = (r + 0.5) * CH - by;
					const u = (x * cos + y * sin) / SIZE;
					const v = -(-x * sin + y * cos) / SIZE;
					const b = sample(u, v, k);
					const i = r * cols + c;
					if (b > trail[i]) trail[i] = b;
				}
			}

			ctx!.clearRect(0, 0, W, H);
			ctx!.font = FONT;
			ctx!.textBaseline = 'top';
			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					const b = trail[r * cols + c];
					if (b < 0.06) continue;
					const ch = RAMP[Math.min(RAMP.length - 1, Math.floor(b * RAMP.length))];
					if (ch === ' ') continue;
					ctx!.fillStyle = `rgba(${rgb}, ${0.2 + b * 0.6})`;
					ctx!.fillText(ch, c * CW, r * CH);
				}
			}

			if (!reduceMotion) requestAnimationFrame(frame);
		}

		resize();
		window.addEventListener('resize', resize);
		requestAnimationFrame(frame);
	}
</script>

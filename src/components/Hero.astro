---
import AsciiButterfly from "./AsciiButterfly.astro";
import { hero } from "../content/site";

// Headline as lines of words; the first word of the first line is highlighted.
// Entry effect copied from ashcamp.co: per-character "appear" (blur 10px, opacity 0, y +10px →
// normal), 0.05s stagger between characters, lines starting at 0 / 0.25 / 0.5 / 0.75s.
const lines = hero.lines;
const PERCH = hero.perch;
const LINE_START = [0, 0.25, 0.5, 0.75];
const CHAR_STAGGER = 0.05;
const ariaText = lines.map((l) => l.join(" ")).join(" ");

const headline = lines.map((words, li) => {
	let idx = 0;
	return words.map((word, wi) => {
		const chars = [...word].map((ch) => ({ ch, delay: LINE_START[li] + idx++ * CHAR_STAGGER }));
		idx++; // the space after the word also counts as a character
		return { chars, strong: li === 0 && wi === 0, perch: word === PERCH };
	});
});
---

<section id="index" class="hero frame">
	<div class="split hero__main">
		<AsciiButterfly />

		<div class="col-narrow hero__spacer" aria-hidden="true"></div>
		<div class="col-wide hero__headline-cell">
			<h1 class="hero__headline" aria-label={ariaText}>
				{
					headline.map((words, li) => (
						<Fragment>
							{words.map((w, wi) => (
								<Fragment>
									{wi > 0 && " "}
									<span class:list={["hero__word", { "hero__word--strong": w.strong }]} data-perch={w.perch || undefined} aria-hidden="true">
										{w.chars.map((c) => (
											<span class="hero__char" style={`--d:${c.delay.toFixed(2)}s`}>
												{c.ch}
											</span>
										))}
									</span>
								</Fragment>
							))}
							{li < headline.length - 1 && <br />}
						</Fragment>
					))
				}
			</h1>
		</div>
	</div>

	<div class="hero__footer">
		{hero.labels.map((label, i) => (
			<span class="eyebrow hero__intro" style={`--intro-delay: ${0.3 + i * 0.08}s`}>{label}</span>
		))}
	</div>
</section>

<!-- Entry gate. CSS animations start counting as soon as styles are computed, but on phones the first
     frame can land a second or more later (web fonts, canvas/WebGL setup), so most of the headline had
     already finished "animating" before anything was on screen. This runs synchronously, before the first
     paint: it arms the hero (text held in its start state) and lets the animation run only once the fonts
     are in (capped) and a frame has actually been painted. Without JS the hero is never armed, so the text
     is simply visible. -->
<script is:inline>
	(() => {
		const hero = document.getElementById("index");
		if (!hero) return;
		hero.dataset.intro = "armed";
		let done = false;
		const play = () => {
			if (done) return;
			done = true;
			requestAnimationFrame(() => requestAnimationFrame(() => (hero.dataset.intro = "play")));
		};
		// the headline's font (fonts.ready alone would resolve before layout has requested any font)
		const font = document.fonts ? document.fonts.load('14px "Fragment Mono"') : Promise.resolve();
		font.then(play, play);
		setTimeout(play, 1200);
	})();
</script>

<script>
	// The butterfly announces that she has touched down on "designer": one pale ring of iridescent colour
	// opens from where she is and spreads over "product designer", once. A copy of those two words is painted
	// with a conic gradient and masked to the ring; it plays for ~2.8 s (companion page, "Onda suave" at 1.45x).
	const WAVE = { duration: 2.76, band: 46, bandGrow: 26, extra: 70, opacity: 0.8, designSize: 22 };

	const easeInOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);

	function playWave() {
		if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		const h1 = document.querySelector<HTMLElement>(".hero__headline");
		const perch = h1?.querySelector<HTMLElement>(".hero__word[data-perch]");
		const prev = perch?.previousElementSibling as HTMLElement | null; // the word before it: "product"
		if (!h1 || !perch || !prev || !prev.classList.contains("hero__word")) return;

		const hr = h1.getBoundingClientRect();
		const pr = prev.getBoundingClientRect();
		const wr = perch.getBoundingClientRect();
		const left = pr.left - hr.left;
		const width = wr.right - pr.left;
		const ox = wr.left - pr.left + wr.width / 2; // where she is, inside the two words
		const reach = Math.max(ox, width - ox);
		const k = parseFloat(getComputedStyle(h1).fontSize) / WAVE.designSize; // distances were designed at 22px

		let wave = h1.querySelector<HTMLElement>(".hero__wave");
		if (!wave) {
			wave = document.createElement("span");
			wave.className = "hero__wave";
			wave.setAttribute("aria-hidden", "true");
			h1.appendChild(wave);
		}
		wave.textContent = `${prev.textContent} ${perch.textContent}`.replace(/\s+/g, " ").trim();
		wave.style.left = `${left}px`;
		wave.style.top = `${pr.top - hr.top}px`;
		wave.style.backgroundImage = `conic-gradient(from 20deg at ${ox}px 50%, #8fe3ee, #b9a6f5, #f0a3d8, #efd596, #a9ecb9, #8fe3ee)`;

		const t0 = performance.now();
		const tick = (now: number) => {
			const t = Math.min(1, (now - t0) / (WAVE.duration * 1000));
			const e = easeInOut(t);
			const r = e * (reach + WAVE.extra * k);
			const band = (WAVE.band + WAVE.bandGrow * e) * k;
			const mask = `radial-gradient(circle at ${ox}px 50%, transparent ${Math.max(0, r - band)}px, #000 ${r}px, transparent ${r + band}px)`;
			wave!.style.webkitMaskImage = mask;
			wave!.style.maskImage = mask;
			wave!.style.opacity = t < 1 ? String(WAVE.opacity * Math.pow(Math.sin(Math.PI * Math.min(1, t * 1.04)), 0.7)) : "0";
			if (t < 1) requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	}

	window.addEventListener("butterfly:perch", playWave);
</script>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		flex: 1 0 auto;
		border-top: none; /* no divider under the nav, like ashcamp (a <script> between them breaks .frame + .frame) */
	}

	.hero__main {
		position: relative;
		flex: 1;
		overflow: hidden;
	}

	.hero__headline-cell {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		/* centered in the whole frame (the nav overlaps the top of the hero), 60px from the divider like ashcamp */
		padding: 80px 48px calc(80px + var(--nav-h) - 47px) 60px; /* 47px ≈ footer row: center in nav + hero + footer */
	}

	.hero__headline {
		font-family: var(--font-mono-read);
		font-weight: 400;
		font-size: 14px;
		/* ashcamp: each line is its own paragraph, line-height 1.2em, 6px gap → 22.8px between lines */
		line-height: calc(1.2em + 6px);
		color: #666666;
		text-transform: uppercase;
		margin: 0;
	}

	.hero__word {
		display: inline-block;
		white-space: nowrap;
	}

	.hero__word--strong {
		font-weight: 400;
		color: var(--fg);
	}

	/* the copy of "product designer" that carries the ring of colour (see the script above) */
	.hero__headline {
		position: relative;
	}

	.hero__headline :global(.hero__wave) {
		position: absolute;
		white-space: nowrap;
		pointer-events: none;
		color: transparent;
		-webkit-background-clip: text;
		background-clip: text;
		opacity: 0;
	}

	/* per-character entry (spring ~0.3s, no bounce). Held in its start state while the hero is "armed"
	   and played once the entry gate (script below the section) has seen a painted frame. */
	.hero__char {
		display: inline-block;
	}

	.hero[data-intro="armed"] .hero__char {
		opacity: 0;
		filter: blur(10px);
		transform: translateY(10px);
	}

	.hero[data-intro="play"] .hero__char {
		animation: hero-char 0.3s cubic-bezier(0.33, 1, 0.68, 1) both;
		animation-delay: var(--d, 0s);
	}

	@keyframes hero-char {
		from {
			opacity: 0.001;
			filter: blur(10px);
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			filter: blur(0);
			transform: translateY(0);
		}
	}

	/* Hero content is always on-screen on load, so it fades in on a timer (same gate as the headline)
	   instead of the scroll-triggered [data-reveal] used elsewhere. */
	.hero[data-intro="armed"] .hero__intro {
		opacity: 0;
		transform: translateY(16px);
	}

	.hero[data-intro="play"] .hero__intro {
		animation: hero-intro 0.8s ease both;
		animation-delay: var(--intro-delay, 0.1s);
	}

	@keyframes hero-intro {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero[data-intro] .hero__intro,
		.hero[data-intro] .hero__char {
			animation: none;
			opacity: 1;
			filter: none;
			transform: none;
		}
	}

	/* white, like ashcamp's footer labels */
	.hero__footer > .eyebrow {
		color: var(--fg);
	}

	/* two labels: location at the left edge, year at the right edge */
	.hero__footer {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		padding: 0;
	}

	.hero__footer > * {
		padding: 16px 20px;
	}

	.hero__footer > :first-child {
		justify-self: start;
	}

	.hero__footer > :last-child {
		justify-self: end;
	}

	/* the vertical divider (the .col-narrow border) runs through the footer row down to the bottom line */
	.hero__footer::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--col-narrow-w) - 1px);
		border-left: var(--border);
		pointer-events: none;
	}

	@media (max-width: 767.98px) {
		.hero__spacer {
			display: none;
		}

		/* ashcamp mobile: text left-aligned at 20px, centered in the frame, no vertical divider */
		.hero__main > .hero__headline-cell {
			flex: 1 1 auto;
			padding: 80px 20px calc(80px + var(--nav-h) - 47px) 20px;
		}

		.hero__footer::before {
			display: none;
		}
	}
</style>

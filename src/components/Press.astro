---
import Media from "./Media.astro";

const items = [
	{ letter: "a", outlet: "Lorem Ipsum Magazine", title: "Dolor sit amet consectetur" },
	{ letter: "b", outlet: "Dolor Sit Radio", title: "Adipiscing elit sed do" },
	{ letter: "c", outlet: "Consectetur Podcast", title: "Eiusmod tempor incididunt" },
	{ letter: "d", outlet: "Adipiscing Weekly", title: "Ut labore et dolore magna" },
];
---

<section class="frame press">
	<div class="split">
		<div class="col-narrow section-head">
			<h2 class="section-title" data-reveal>Experiencia en campo</h2>
		</div>

		<div class="col-wide press__cell">
			<div class="press__flick" id="press-flick-wrap">
				<div class="flicking-viewport" id="press-flick">
					<div class="flicking-camera">
						{items.map((item) => (
							<div class="press__panel">
								<div class="poster">
									<div class="art"><Media kind="image" ratio="3 / 4" /></div>
								</div>
								<div class="meta">
									<span class="press__outlet">({item.letter}) {item.outlet}</span>
									<p class="press__title">{item.title}</p>
								</div>
							</div>
						))}
					</div>
				</div>

				<span class="flicking-arrow-prev"></span>
				<span class="flicking-arrow-next"></span>
				<div class="flicking-pagination"></div>
			</div>
		</div>
	</div>
</section>

<script>
	import Flicking from "@egjs/flicking";
	import { Perspective, Parallax, Fade, AutoPlay, Arrow, Pagination } from "@egjs/flicking-plugins";
	import "@egjs/flicking/dist/flicking.css";
	import "@egjs/flicking-plugins/dist/flicking-plugins.css";

	const wrap = document.getElementById("press-flick-wrap");

	if (wrap) {
		const flicking = new Flicking("#press-flick", {
			circular: true,
			align: "center",
			moveType: ["snap", { count: 1 }],
		});

		flicking.addPlugins(
			new Perspective({ selector: ".poster", rotate: -0.42, scale: 0.32, perspective: 900 }),
			new Parallax(".art", 0.9),
			new Fade(".meta", 1.6),
			new AutoPlay({ duration: 2000, animationDuration: 1050, direction: "NEXT", stopOnHover: true }),
			new Arrow({ parentEl: wrap }),
			new Pagination({ parentEl: wrap, type: "bullet" }),
		);
	}
</script>

<style>
	/* media-side cell: 60px padding (40px tablet, 40/20 mobile) */
	.press__cell {
		min-width: 0;
		padding: 60px;
	}

	.press__flick {
		position: relative;
		padding-bottom: 56px; /* room for the pagination bullets */
	}

	.press__flick :global(.flicking-viewport) {
		overflow: hidden;
	}

	.press__panel {
		width: min(400px, 52vw);
		padding: 0 10px;
	}

	.press__panel :global(.poster) {
		position: relative;
		overflow: hidden;
		border-radius: 10px;
		aspect-ratio: 3 / 4;
	}

	/* the Parallax plugin sets translate(-50%) + an offset, so the art is centered with left: 50% and is
	   wider than the poster, leaving room for the shift */
	.press__panel :global(.art) {
		position: absolute;
		top: 0;
		left: 50%;
		width: 130%;
		height: 100%;
	}

	.press__panel :global(.art .placeholder-media) {
		height: 100%;
		aspect-ratio: auto !important;
		border-radius: 0;
	}

	.press__outlet {
		display: block;
		margin-top: 16px;
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 1.2em;
		letter-spacing: 0;
		text-transform: uppercase;
		color: #666;
	}

	.press__title {
		margin: 8px 0 0;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.2em;
		letter-spacing: 0;
		color: var(--fg);
	}

	/* plugin controls on the dark background */
	.press__flick :global(.flicking-arrow-prev::before),
	.press__flick :global(.flicking-arrow-prev::after),
	.press__flick :global(.flicking-arrow-next::before),
	.press__flick :global(.flicking-arrow-next::after) {
		background: #fff;
	}

	.press__flick :global(.flicking-pagination-bullet) {
		background: #333;
	}

	.press__flick :global(.flicking-pagination-bullet-active) {
		background: #fff;
	}

	@media (max-width: 1199.98px) {
		.press__cell {
			padding: 40px;
		}

		.press__title {
			font-size: 13px;
		}
	}

	@media (max-width: 767.98px) {
		.press__cell {
			padding: 40px 20px;
		}

		.press__panel {
			width: 72vw;
		}
	}
</style>
